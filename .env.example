# Copy to .env (never commit .env). Everything is optional except the contact webhook.

# Contact form → this Discord channel webhook.
DISCORD_WEBHOOK_URL=
# Discord user ID to ping on each message (optional).
DISCORD_MENTION_USER_ID=

# Fine-grained GitHub token, read-only: "Public repositories" access, no extra permissions.
# Without it the site falls back to the unauthenticated REST API (no CI status, releases or language split).
GITHUB_TOKEN=
# GitHub user whose public repos are shown (defaults to "owner" in site.config.json).
GITHUB_OWNER=
# Secret shared with the GitHub webhook that points at /api/github.
GITHUB_WEBHOOK_SECRET=
# Minutes before cached GitHub data counts as stale (default 30).
GITHUB_CACHE_TTL_MINUTES=30
# Where the GitHub cache file lives (default ./.cache). deploy.ps1 points every release at one shared folder.
CACHE_DIR=

# Public URL, used for canonical links, OG images, sitemap and RSS (defaults to siteUrl in site.config.json).
SITE_URL=
